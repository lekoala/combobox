{
  "name": "@lekoala/combobox",
  "version": "0.0.0",
  "private": true,
  "description": "Native-first <combo-box> combobox/filterable-select",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "node test/server.js",
    "test": "bun run test:browser",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed",
    "test:syntax": "node --check src/combobox.js && node --check src/combo-box.js",
    "lint": "biome check src test playwright.config.js",
    "format": "biome format --write src test playwright.config.js",
    "check": "bun run test:syntax && bun run lint && bun run test:browser"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.55.0"
  }
}
